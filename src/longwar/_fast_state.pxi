    cdef int16_t last_battle_start_hand_size[PLAYER_COUNT]
    cdef int16_t last_cards_drawn[PLAYER_COUNT]
    cdef int16_t last_completion_count[PLAYER_COUNT]
    cdef int16_t last_operations[PLAYER_COUNT]
    cdef int8_t last_pass_order[PLAYER_COUNT]
    cdef uint8_t last_pass_len
    cdef uint8_t cleanup_pending
