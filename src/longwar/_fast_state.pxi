    cdef uint8_t pending_draw_finish_operation

    cdef int8_t pending_kind[MAX_PENDING_EFFECTS]
    cdef int8_t pending_player[MAX_PENDING_EFFECTS]
    cdef int8_t pending_card[MAX_PENDING_EFFECTS]
