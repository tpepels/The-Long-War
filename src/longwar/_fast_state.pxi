    cdef uint8_t discount_minimum[MAX_SLOT_DISCOUNTS]
    cdef uint8_t discount_card_type_mask[MAX_SLOT_DISCOUNTS]
    cdef int32_t discount_expires_turn[MAX_SLOT_DISCOUNTS]
    cdef uint8_t discount_len

    cdef uint8_t passed[PLAYER_COUNT]
    cdef int8_t pass_order[PLAYER_COUNT]
    cdef uint8_t pass_len
    cdef uint8_t discarded_this_battle[PLAYER_COUNT]
    cdef int16_t command[PLAYER_COUNT]
    cdef uint16_t operations_this_battle[PLAYER_COUNT]
    cdef uint8_t actions_this_turn
    cdef uint8_t closing_turns_remaining
    cdef uint8_t cards_played_this_turn_front_mask[PLAYER_COUNT]
    cdef uint8_t cards_played_this_battle_front_mask[PLAYER_COUNT]
    cdef uint8_t narratives_played_this_battle[PLAYER_COUNT]
    cdef int16_t command_spent_this_battle[PLAYER_COUNT]
    cdef int16_t command_refunded_this_battle[PLAYER_COUNT]
    cdef int16_t battle_start_command[PLAYER_COUNT]
    cdef int16_t battle_start_hand_size[PLAYER_COUNT]
    cdef int16_t cards_drawn_this_battle[PLAYER_COUNT]
    cdef int16_t completion_count_this_battle[PLAYER_COUNT]
    cdef int16_t deck_reshuffles[PLAYER_COUNT]
    cdef int16_t reshuffle_card_totals[PLAYER_COUNT]
    cdef int16_t reshuffle_hand_card_totals[PLAYER_COUNT]
    cdef uint8_t last_battle_valid
    cdef int16_t last_battle
    cdef int16_t last_front_scores[FRONT_COUNT][PLAYER_COUNT]
    cdef uint8_t last_lost_mask[PLAYER_COUNT]
    cdef int16_t last_command_start[PLAYER_COUNT]
    cdef int16_t last_command_spent[PLAYER_COUNT]
    cdef int16_t last_command_refunded[PLAYER_COUNT]
    cdef int16_t last_command_before_collapse[PLAYER_COUNT]
